{
  "permissions": {
    "allow": [
      "Bash(zola build)", "Bash(zola build:*)", "Bash(zola serve:*)",
      "Bash(zola check)", "Bash(zola check:*)", "Bash(zola --version)",
      "Bash(python3 -m http.server:*)",
      "Bash(scripts/check-offline.sh:*)",
      "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)", "Bash(ls:*)",
      "Bash(du:*)", "Bash(wc:*)", "Bash(file:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)", "Bash(git show:*)", "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(rm -rf:*)", "Bash(rm -fr:*)", "Bash(rm -r -f:*)",
      "Bash(git clean:*)", "Bash(git branch -D:*)", "Bash(git branch -d:*)",
      "Bash(git push:*)", "Bash(git push --force-with-lease:*)",
      "Bash(gh repo create:*)", "Bash(gh repo delete:*)", "Bash(gh release:*)",
      "Bash(curl:*)", "Bash(wget:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard-bash.py\"" }
        ]
      }
    ]
  }
}
